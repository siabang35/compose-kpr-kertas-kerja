# ==============================================================================
# Environment Configuration - KPR Kertas Kerja
# Deployment Target: VM gc-bribrain-dev-vai-face-01
# ==============================================================================

# ── 1. Google Cloud Artifact Registry Images ─────────────────────────────────
REGISTRY_URL=asia-southeast2-docker.pkg.dev/common-cicd-dev-01/gc-bribrain-dev-gar-temp-01
API_IMAGE=asia-southeast2-docker.pkg.dev/common-cicd-dev-01/gc-bribrain-dev-gar-temp-01/kpr-kertas-kerja-api:latest
NGINX_IMAGE=asia-southeast2-docker.pkg.dev/common-cicd-dev-01/gc-bribrain-dev-gar-temp-01/kpr-kertas-kerja-nginx:latest

# ── 2. Port & Network Binding ─────────────────────────────────────────────────
# Port publik Nginx yang melayani trafik BRIspot (default 8000):
NGINX_PORT=8000
# Port internal API (bind ke loopback 127.0.0.1 VM untuk testing lokal):
API_PORT=8001
API_BIND_IP=127.0.0.1

# ── 3. Profil Aplikasi ────────────────────────────────────────────────────────
APP_ENV=production
API_PREFIX=/api/v1
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json

# ── 4. Resource & Concurrency ─────────────────────────────────────────────────
WEB_CONCURRENCY=2
LIMIT_CONCURRENCY=256
API_CPUS=2.0

# ── 5. Database (PostgreSQL / Cloud SQL) ──────────────────────────────────────
# Isi dengan IP host database atau Cloud SQL Auth Proxy
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=kpr_analysis
POSTGRES_USER=kpr_user
POSTGRES_PASSWORD=
POSTGRES_APP_USER=kpr_app
POSTGRES_APP_PASSWORD=

# ── 6. Keamanan & API Keys (>= 32 karakter) ──────────────────────────────────
# Kunci autentikasi untuk header X-API-Key
KPR_API_KEY=
INTERNAL_API_KEY=

# ── 7. Layanan Integrasi Downstream ──────────────────────────────────────────
KLASIFIKASI_URL=
KLASIFIKASI_API_KEY=
AKTA_CALC_URL=
AKTA_CALC_API_KEY=
OCR_RESULT_URL=
OCR_RESULT_API_KEY=
INTEGRASI_DUMMY=false